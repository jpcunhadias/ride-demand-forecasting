# Python-generated files
__pycache__/
*.py[oc]
build/
dist/
wheels/
*.egg-info

# Virtual environments
.venv

# Data (Kaggle-licensed, not ours to redistribute) - keep the folder
# structure visible via .gitkeep, but not the actual CSVs.
data/raw/*
!data/raw/.gitkeep
data/processed/*
!data/processed/.gitkeep

.ipynb_checkpoints/
.pytest_cache/
.ruff_cache/
.mypy_cache/
cache/

# Local overrides for docker-compose.yml and host-side commands (see .env.example).
.env
!.env.example
