# Copy to .env to override. Docker Compose reads .env on its own; for commands run on
# the host, pass it explicitly: `uv run --env-file .env dvc repro`.

# --- Local stack (docker-compose.yml) -------------------------------------------------
# Local-only defaults. Change them before exposing the stack beyond your own machine.
POSTGRES_USER=rdf
POSTGRES_PASSWORD=rdf-local-only
# The object store's credentials in the local stack, which are also what DVC uses for
# its S3 remote (`dvc push` / `dvc pull`).
AWS_ACCESS_KEY_ID=rdf-local
AWS_SECRET_ACCESS_KEY=rdf-local-only
# The address published ports listen on. 127.0.0.1 keeps the stack private to this
# machine. Use 0.0.0.0 to reach it from other computers, and only on a network you
# trust: the storage admin UI (S3_ADMIN_PORT) is not protected by the credentials above.
BIND_ADDRESS=127.0.0.1
# Host ports. MLflow defaults to 5001 because macOS keeps 5000 for AirPlay Receiver.
MLFLOW_PORT=5001
S3_PORT=8333
S3_ADMIN_PORT=23646
API_PORT=8000
# Host names the MLflow server answers to. Add the machine's own name or address when
# reaching it from another computer, e.g. "localhost:*,my-server:*".
MLFLOW_ALLOWED_HOSTS=localhost:*,127.0.0.1:*,mlflow:*

# --- Experiment tracking ---------------------------------------------------------------
# Optional. When set, `ride-demand-train` logs each run to this MLflow server; when
# empty, training skips tracking and needs no external service.
MLFLOW_TRACKING_URI=http://localhost:5001
# Only for a server with authentication turned on.
MLFLOW_TRACKING_USERNAME=
MLFLOW_TRACKING_PASSWORD=

# --- Data versioning -------------------------------------------------------------------
# The DVC remote is s3://ride-demand-forecasting/dvc. Where that bucket lives is
# machine-specific, so the address goes in .dvc/config.local (not committed). For the
# local stack:
#   uv run dvc remote modify --local storage endpointurl http://localhost:8333
